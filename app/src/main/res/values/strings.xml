    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_purpose_title">Purpose</string>
    <string name="about_purpose_body">CampusFix is an educational Android application that demonstrates how students could report campus problems (broken equipment, Wi-Fi outages, cleanliness issues) and track their status — while teaching the Android concepts used to build it.</string>
    <string name="about_honesty_title">Demonstration only</string>
    <string name="about_honesty_body">All reports, status changes, statistics and reminders are local demonstrations stored on this device. There is no backend, no campus administration integration, and no real repair process.</string>
    <string name="about_offline_title">Offline by design</string>
    <string name="about_offline_body">Core features — creating, editing, searching and tracking reports, statistics, and the Learning Lab — work fully without an internet connection.</string>

