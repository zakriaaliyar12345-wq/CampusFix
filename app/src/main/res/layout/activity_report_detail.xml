<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Status + badges row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailSampleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@drawable/bg_pill"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/badge_sample"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Category • priority -->
        <TextView
            android:id="@+id/tvDetailCategoryPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body" />

        <!-- Dates -->
        <TextView
            android:id="@+id/tvDetailCreated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/tvDetailUpdated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />

        <!-- Location -->
        <TextView
            style="@style/TextAppearance.CampusFix.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_location" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/detail_location"
                android:src="@drawable/ic_location"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            style="@style/TextAppearance.CampusFix.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_description" />

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body" />

        <!-- Photo -->
        <TextView
            style="@style/TextAppearance.CampusFix.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_photo" />

        <ImageView
            android:id="@+id/ivDetailPhoto"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/surface_variant_light"
            android:contentDescription="@string/detail_photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDetailNoPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_no_photo"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />

        <!-- Status history -->
        <TextView
            style="@style/TextAppearance.CampusFix.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_history" />

        <TextView
            android:id="@+id/tvHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_none"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Actions -->
        <TextView
            style="@style/TextAppearance.CampusFix.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_actions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditReport"
            style="@style/Widget.CampusFix.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_edit"
            app:icon="@drawable/ic_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimulateStatus"
            style="@style/Widget.CampusFix.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/detail_simulate_status" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareReport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/detail_share"
            app:icon="@drawable/ic_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMap"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/detail_open_map"
            app:icon="@drawable/ic_location" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteReport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/action_delete"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_delete"
            app:strokeColor="?attr/colorError" />

        <!-- Demo honesty note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/detail_simulate_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />

    </LinearLayout>
</ScrollView>
